extends Node
## Textos del juego en espanol e ingles. Para agregar un idioma, agrega una columna.

func lang_index() -> int:
	return 1 if String(Game.settings.get("lang", "es")) == "en" else 0

var female := false  # el jugador es mujer: "mijo" -> "mija"

func t(k: String) -> String:
	if T.has(k):
		var txt: String = T[k][lang_index()]
		if female and lang_index() == 0 and txt.contains("ijo"):
			txt = txt.replace("Mijo", "Mija").replace("mijo", "mija")
		return txt
	return k

func has(k: String) -> bool:
	return T.has(k)

